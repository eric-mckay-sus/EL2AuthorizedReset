@using Microsoft.AspNetCore.Components.Authorization

<div class="nav-scrollable @(isExpanded ? "sidebar-expanded" : "")">
    <div class="sidebar-header">
        <div class="header-content">
            <a class="stanley-icon" href=""></a>
            <a class="header-brand" href="">Authorized Reset</a>
        </div>
    </div>

    <nav class="flex-column">
        <div class="nav-item navbar-toggler">
            <Button class="nav-link" @onclick="ToggleNavMenu" title="Navigation menu">
                <Icon Name="IconName.List" Color="IconColor.White" Class="toggler-icon" />
                <label>Collapse Navbar</label>
            </Button>
        </div>
        <div class="nav-item">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All" @onclick="CollapseNavMenu">
                <Icon Name="IconName.Clock" />
                <label>Historical Records</label>
            </NavLink>
        </div>
        <div class="nav-item">
            <NavLink class="nav-link" href="view-lines" Match="NavLinkMatch.All" @onclick="CollapseNavMenu">
                <Icon Name="IconName.FilterSquare" />
                <label>View Line Status</label>
            </NavLink>
        </div>

        <AuthorizeView Roles="Manager">
            <Authorized>
                <div class="nav-item">
                    <NavLink class="nav-link" href="manage" Match="NavLinkMatch.All" @onclick="CollapseNavMenu">
                        <Icon Name="IconName.PeopleFill" />
                        <label>Manage Associates & <br> Lines</label>
                    </NavLink>
                </div>

                <div class="nav-item">
                    <NavLink class="nav-link" href="import-cmms-mappings" Match="NavLinkMatch.All" @onclick="CollapseNavMenu">
                        <Icon Name="IconName.CloudArrowUpFill" />
                        <label>Update CMMS</label>
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private bool isExpanded = false;

    /// <summary>
    /// Gets or sets the action to perform elsewhere when toggling
    /// </summary>
    [Parameter]
    public EventCallback<bool> OnToggle { get; set; }

    private async Task ToggleNavMenu()
    {
        isExpanded = !isExpanded;
        await OnToggle.InvokeAsync(isExpanded);
    }

    private async Task CollapseNavMenu()
    {
        // Useful for mobile: close the menu automatically after clicking a link
        isExpanded = false;
        await OnToggle.InvokeAsync(isExpanded);
    }
}
