@using Microsoft.AspNetCore.Components.Authorization
@inject IJSRuntime JS

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable @NavMenuCssClass" onclick="document.querySelector('.navbar-toggler').click()">
    <div class="sidebar-header">
        <div class="header-content">
            <a class="stanley-icon" href=""></a>
            <a class="header-brand" href="">Authorized Reset</a>
        </div>
    </div>

    <nav class="flex-column">
        <div class="nav-item">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <Icon Name="IconName.Clock" />
                <label>Historical Records</label>
            </NavLink>
        </div>
        <div class="nav-item">
            <NavLink class="nav-link" href="view-lines">
                <Icon Name="IconName.FilterSquare" />
                <label>View Line Status</label>
            </NavLink>
        </div>

        <AuthorizeView Roles="Admin">
            <Authorized>
                <div class="nav-item">
                    <NavLink class="nav-link" href="manage">
                        <Icon Name="IconName.PeopleFill" />
                        <label>Manage Associates & <br> Lines</label>
                    </NavLink>
                </div>

                <div class="nav-item">
                    <NavLink class="nav-link" href="import-cmms-mappings">
                        <Icon Name="IconName.CloudArrowUpFill" />
                        <label>Update CMMS</label>
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>
    </nav>
</div>

@code
{
    [Parameter]
    public EventCallback<bool> ShowIconMenu { get; set; }

    private bool IconMenuActive { get; set; } = true;
    private bool collapseNavMenu = false;
    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("setResizeCallback", DotNetObjectReference.Create(this));
        }
    }

    [JSInvokable]
    public async Task OnResize(bool isBelowThreshold)
    {
        if (isBelowThreshold && IconMenuActive)
        {
            collapseNavMenu = true;
            await ToggleIconMenu();

            await ShowIconMenu.InvokeAsync(IconMenuActive);

            await InvokeAsync(StateHasChanged);
        }
    }

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    private async Task ToggleIconMenu()
    {
        IconMenuActive = !IconMenuActive;

        await ShowIconMenu.InvokeAsync(IconMenuActive);
    }
}
