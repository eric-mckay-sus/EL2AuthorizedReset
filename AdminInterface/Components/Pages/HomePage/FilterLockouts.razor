@inherits EntityManagerBase<Lockout, Lockout>

<div class="filter-panel mb-3 p-3 border rounded bg-light">
    <div class="row g-3">
        <div class="col-3">
            <label class="form-label">CMMS #</label>
            <input type="number" 
                   class="form-control"
                   @bind-value="FilterCmmsNum.Value" 
                   @bind-value:event="oninput" 
                   placeholder="Enter complete CMMS number" />
        </div>
        <div class="col-3">
            <label class="form-label">Reason</label>
            <input type="text" 
                   class="form-control"
                   @bind-value="FilterReason.Value" 
                   @bind-value:event="oninput" 
                   placeholder="Enter part or all of reason..." />
        </div>
        <div class="col-3">
            <label class="form-label">From Date</label>
            <input type="date" 
                   class="form-control"
                   value="@FilterStartDate.Value?.ToString("yyyy-MM-dd")" 
                   @oninput="@(e => FilterStartDate.Value = string.IsNullOrEmpty(e.Value?.ToString()) ? null : DateTime.Parse(e.Value.ToString()!))" />
        </div>

        <div class="col-3">
            <label class="form-label">To Date</label>
            <input type="date" 
                   class="form-control"
                   value="@FilterEndDate.Value?.ToString("yyyy-MM-dd")" 
                   @oninput="@(e => FilterEndDate.Value = string.IsNullOrEmpty(e.Value?.ToString()) ? null : DateTime.Parse(e.Value.ToString()!))" />
        </div>

        <div class="col-12 d-flex justify-content-end gap-3">
            <button class="btn btn-outline-secondary" @onclick="ClearAllFilters">Clear</button>
            <button class="btn btn-primary" @onclick="LoadData">Execute</button>
        </div>
    </div>
</div>

@if (IsLoading){
    <Spinner Color="SpinnerColor.Primary" />
} else {
    <UniversalTable T="Lockout" Items="DataView" />
}

@code {
    protected Filter<int?> FilterCmmsNum => GetFilter<int?>("cmmsNum");
    protected Filter<string?> FilterReason => GetFilter<string?>("reason");
    protected Filter<DateTime?> FilterStartDate => GetFilter<DateTime?>("after");
    protected Filter<DateTime?> FilterEndDate => GetFilter<DateTime?>("before");

    /// <summary>
    /// Initializes the filter registry with default values
    /// </summary>
    protected override void InitializeFilters()
    {
        if (_filtersInitialized) return;

        Filters["cmmsNum"] = new Filter<int?>("cmmsNum", null);
        Filters["reason"] = new Filter<string?>("reason", null);
        Filters["after"] = new Filter<DateTime?>("after", null);
        Filters["before"] = new Filter<DateTime?>("before", null);

        _filtersInitialized = true;
    }

    protected override IQueryable<Lockout> ApplyFilter(IQueryable<Lockout> query)
    {
        var filterCmmsNum = GetFilter<int?>("cmmsNum");
        var filterReason = GetFilter<string?>("reason");
        var filterStartDate = GetFilter<DateTime?>("after");
        var filterEndDate = GetFilter<DateTime?>("before");

        // Apply CMMS Number filter
        if (filterCmmsNum.IsActive)
        {
            query = query.Where(r => r.CmmsNum == filterCmmsNum.Value);
        }

        // Apply Line Name filter (contains - case insensitive)
        if (filterReason.IsActive && !string.IsNullOrWhiteSpace(filterReason.Value))
        {
            var searchLine = filterReason.Value.ToLower();
            query = query.Where(r => r.Reason.Contains(searchLine));
        }

        // Apply Start Date filter (inclusive)
        if (filterStartDate.IsActive)
        {
            query = query.Where(r => r.Timestamp >= filterStartDate.Value);
        }

        // Apply End Date filter (inclusive - include the entire day)
        if (filterEndDate.IsActive)
        {
            var endOfDay = filterEndDate.Value?.AddDays(1).AddTicks(-1);
            query = query.Where(r => r.Timestamp <= endOfDay);
        }

        return query;
    }
}