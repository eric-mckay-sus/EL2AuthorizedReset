@page "/"

<PageTitle>EL2 Auth Reset</PageTitle>

<h2>Lockouts & Resets</h2>

<div class="row overflow-hidden flex-nowrap">
    @* Split screen when expanded, otherwise fullscreen the lockout table *@
    <div class="@(isTargeting ? "col-7" : "col-12") transition-width">
        <SearchLockouts Target="target" HandleExpand="HandleExpand" OnItemChanged="HandleLockoutResetNotShown"/>
    </div>
    <div class="@(isTargeting ? "col-5" : "col-0") transition-width overflow-hidden"
         style="@(isTargeting ? "" : "display:none;")">
            @if (isTargeting) {
                <TargetedResets Target="target" OnClose="HandleClose" />
            }
    </div>
</div>

@code{
    private LockoutReset? target;
    private bool isTargeting = false;

    private void HandleExpand(LockoutReset lockoutReset) {
        if (lockoutReset.Equals(target)){
            HandleClose();
        } else {
            target = lockoutReset;
            isTargeting = true;
        }
    }
    private void HandleClose(){
        target = null;
        isTargeting = false;
    }

    private void HandleLockoutResetNotShown(LockoutReset changedLockoutReset)
    {
        if (target != null && changedLockoutReset.Equals(target))
        {
            HandleClose();
        }
    }
}
