@page "/"
@inherits HomeBase

<PageTitle>EL2 Auth Reset</PageTitle>

<h2>Lockouts & Resets</h2>

<div class="filter-panel mb-3 p-3 border rounded bg-light">
    <div class="row g-3">
        <div class="col-2">
            <label class="form-label">CMMS #</label>
            <input type="number" class="form-control" @bind-value="FilterCmmsNum.Value" @bind-value:event="oninput" placeholder="Search machine ID..." />
        </div>
        <div class="col-2">
            <label class="form-label">Status</label>
            <select class="form-select" @bind="FilterStatus.Value">
                <option value="">All Records</option>
                <option value="Locked out">Locked out</option>
                <option value="Released">Released</option>
            </select>
        </div>
        <div class="col-2">
            <label class="form-label">Lockout Level</label>
            <div class="input-group">
                <button class="btn btn-secondary" 
                        type="button" 
                        @onclick="() => lockoutLevelGreaterThan = !lockoutLevelGreaterThan"
                        title="@(lockoutLevelGreaterThan ? "Search higher lockout level" : "Search lower lockout level")">
                    @if (lockoutLevelGreaterThan) {
                        <span class="fw-bold">&ge;</span>
                    } else {
                        <span class="fw-bold">&le;</span>
                    }
                </button>
                <input type="number" class="form-control" @bind-value="FilterLockoutLevel.Value" @bind-value:event="oninput" placeholder="Filter lockout level..." />
            </div>
        </div>
        <div class="col-2">
            <label class="form-label">Reason</label>
            <input type="text" class="form-control" @bind-value="FilterReason.Value" @bind-value:event="oninput" placeholder="Fault description..." />
        </div>
        <div class="col-2">
            <label class="form-label">Resetter Name</label>
            <input type="text" class="form-control" @bind-value="FilterResetter.Value" @bind-value:event="oninput" placeholder="Enter associate name" />
        </div>
        <div class="col-2">
            <label class="form-label">Line Name</label>
            <input type="text" class="form-control" @bind-value="FilterLineName.Value" @bind-value:event="oninput" placeholder="e.g. F24" />
        </div>

        <div class="col-3">
            <label class="form-label">Lockout After</label>
            <input type="datetime-local" class="form-control" @bind="FilterLockAfter.Value" />
        </div>
        <div class="col-3">
            <label class="form-label">Lockout Before</label>
            <input type="datetime-local" class="form-control" @bind="FilterLockBefore.Value" />
        </div>
        <div class="col-3">
            <label class="form-label">Reset After</label>
            <input type="datetime-local" class="form-control" @bind="FilterResetAfter.Value" />
        </div>
        <div class="col-3">
            <label class="form-label">Reset Before</label>
            <input type="datetime-local" class="form-control" @bind="FilterResetBefore.Value" />
        </div>

        <div class="col-12 d-flex justify-content-end gap-3">
            <button class="btn btn-outline-secondary" @onclick="ClearAllFilters">Clear</button>
            <button class="btn btn-primary" @onclick="() => LoadData()">Execute</button>
        </div>
    </div>
</div>

@if (IsLoading) {
    <div class="text-center p-5">
        <Spinner Color="SpinnerColor.Primary" />
        <p class="mt-2 text-muted">Fetching historical data...</p>
    </div>
} else {
    <div class="row overflow-hidden flex-nowrap">
        @if (DataView.Count > 0){
            <div class="@(isTargeting ? "col-7" : "col-12") transition-width">
                <TablePresenter 
                    TWrite="Lockout"
                    TRead="LockoutReset" 
                    Base="this"
                    OnExpand="HandleExpand"
                    target="target" />
            </div>
        }
        <div class="@(isTargeting ? "col-5" : "col-0") transition-width overflow-hidden" 
            style="@(isTargeting ? "" : "display:none;")">
            @if (isTargeting) {
                <FilterResets target="target" OnClose="HandleClose" />
            }
        </div>
    </div>
}