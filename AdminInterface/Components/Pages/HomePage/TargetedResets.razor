@inherits EntityManagerBase<Reset, Reset>

@if (Target != null){ @* For prerendering cases*@
    <div class="d-flex justify-content-between mb-3">
        <h2>CMMS #<strong>@Target.CmmsNum</strong> reset requests for lockout at @Target.LockoutTime</h2>
        @if (OnClose.HasDelegate){
            <button type="button" class="btn-close" title="Close reset history split screen" @onclick="OnClose"></button>
        }
    </div>
    <label class="form-label">Denial Type</label>
    <select class="form-select mb-3"
            value="@FilterDenialType.Value?.ToString().ToLower()"
            title="Filter by reset requests from associates with insufficent auth level or without privileges on that line altogether"
            @onchange="ChangeDenialType">
        <option value="">All Records</option>
        <option value="true">Auth Level</option>
        <option value="false">Line Privilege</option>
    </select>

    @if (IsLoading){
        <Spinner Color="SpinnerColor.Primary" />
    } else {
        @if(DataView.Count == 0){
            <h5>No records matched your criteria.</h5>
        } else{
            var authorizedEntry = DataView.FirstOrDefault(x => x.IsAuthorized); // Works bc we're sorting by authorization descending
            <TablePresenter
                TRead="Reset"
                TWrite="Reset"
                Base="this"
                Target="authorizedEntry"
                HighlightStyle="table-success" />
        }
    }
}
