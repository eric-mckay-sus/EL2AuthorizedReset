<div class="d-flex justify-content-between align-items-center p-0 px-3 style="cursor: pointer" @onclick="HandleToggle">
    <div class="d-flex align-items-center gap-2">
        <h5 class="mb-0" style="cursor: pointer;"><i class="bi bi-funnel"></i> Filters</h5>
        @if (activeFilterCount > 0)
        {
            <span class="badge rounded-pill bg-primary">@activeFilterCount active</span>
        }
        @if (pendingFilterCount > 0)
        {
            <span class="badge rounded-pill bg-secondary">@pendingFilterCount pending</span>
        }
    </div>

    <button class="btn btn-link text-decoration-none">
        @(IsCollapsed ? "Show Filters ▼" : "Hide Filters ▲")
    </button>
</div>

@code{
    [Parameter] public int activeFilterCount { get; set; } = 0;
    [Parameter] public int pendingFilterCount { get; set; } = 0;
    [Parameter] public bool IsCollapsed { get; set; }
    [Parameter] public EventCallback<bool> IsCollapsedChanged { get; set; }

    private async Task HandleToggle()
    {
        IsCollapsed = !IsCollapsed;
        await IsCollapsedChanged.InvokeAsync(IsCollapsed);
    }
}
