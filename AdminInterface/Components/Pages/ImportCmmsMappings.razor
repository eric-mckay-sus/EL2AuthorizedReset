@page "/import-cmms-mappings"
@using CmmsCsvReader
@inherits EntityManagerBase<CmmsLine, CmmsLine>
@inject IWebHostEnvironment Environment
@attribute [Authorize(Roles = "Admin")]
@implements IDisposable

<PageTitle>Import CMMS Mappings</PageTitle>

<h2>Update CMMS Mappings</h2>

<p>Upload a CSV of the Maximo export here to update the line names (locations) associated with each machine's CMMS number when a machine moves between lines</p>
<p>Date of last upload: <strong>@_lastUpload</strong></p>
<Alert Color="AlertColor.Warning" Class="d-inline-block"><Icon Name="IconName.ExclamationDiamond" />
    If successful, this will overwrite the existing CMMS mappings (associates will retain their <em>lines</em>, all machines will have no connection to their old line)
</Alert>

<div class="centered-container mb-3">
    <div class="upload-card @(_isDragging ? "drag-active" : "")">
        <label for="fileInput" class="upload-button">
            <i class="bi bi-cloud-arrow-up" style="font-size: 26px"></i> Choose CSV File
        </label>
        <InputFile id="fileInput" OnChange="e => _selectedFile = e.File" accept=".csv" class="hidden-input-overlay"
            @ondragenter="HandleDragEnter"
            @ondragleave="HandleDragLeave"
            @ondragover="HandleDragOver"
            @ondrop="HandleDrop" />

        @if (!string.IsNullOrEmpty(_uploadStatus))
        {
            <div class="status-box mt-3">
                <div class="status-header">Upload Progress</div>
                <pre class="status-content">@_uploadStatus</pre>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(_validationPrompt))
        {
            <Alert Color="AlertColor.Warning" Class="mt-3">
                @_validationPrompt
            </Alert>
        }
    </div>
</div>

<div class="expandable-container">
    <div class="expandable-wrapper @(_confirmationOpen ? "is-expanded" : "")">
        <div class="expandable-content">
            <Alert Color="AlertColor.Danger" Class="mt-3 animate-fade-in">
                <p>
                    <strong>File Selected:</strong>
                    @(_selectedFile?.Name ?? "No file selected")
                    (@((_selectedFile?.Size ?? 0) / 1024) KB)</p>
                <Button Color="ButtonColor.Danger" @onclick="HandleFileSelection">
                    <Icon Name="IconName.ExclamationTriangle" /> Confirm Overwrite
                </Button>
                <Button Color="ButtonColor.Secondary" @onclick="() => _selectedFile=null">Cancel</Button>
            </Alert>
        </div>
    </div>
</div>


@if (IsLoading){
    <Spinner Color="SpinnerColor.Primary" />
} else {
    @if (TotalCount > 100){
        <Alert Color="AlertColor.Info" Class="d-inline-flex"><Icon Name="IconName.InfoCircle" Class="me-2" />This is a preview of the current mappings. There are more viewable on the View Line Status page.</Alert>
    }
    <UniversalTable T="CmmsLine" Items="DataView" />
}

@code {
    private string? _uploadStatus;
    private string _lastUpload = "Loading...";
    private IBrowserFile? _selectedFile;
    private string? _filePath;
    private bool _isDragging = false;
    private bool _isUploading = false;
    private string? _validationPrompt;
    private bool _confirmationOpen => _selectedFile != null && !_isUploading;

    private void HandleDragEnter() => _isDragging = true;
    private void HandleDragOver() => _isDragging = true;
    private void HandleDragLeave() => _isDragging = false;
    private void HandleDrop() => _isDragging = false;

    /// <summary>
    /// Gets the path of the uploads folder for this session.
    /// </summary>
    protected static string UploadsFolderPath { get => Path.Combine(Path.GetTempPath(), "uploads", field); } = Guid.NewGuid().ToString();

    /// <summary>
    /// When this page loads, set up the connection string and get the last upload date
    /// </summary>
    /// <returns></returns>
    protected override async Task OnInitializedAsync()
    {
        // No risk of using null-forgiving operator because the app would have already crashed without a connection
        PageSize = 100;
        CurrentSortColumn="CmmsNum";
        SortDir = "ascending";
        _lastUpload = await UploadCsvToDb.GetLastUpdatedDate();
        InputProvider.OnInputRequested += this.HandleInputRequested;
        Reporter.OnNotify += this.HandleReporterNotify;
    }

    private void HandleInputRequested(Report prompt, string? previousError)
    {
        _validationPrompt = string.IsNullOrWhiteSpace(previousError) ? prompt.message : $"{previousError}\n{prompt.message}";
        InvokeAsync(StateHasChanged);
    }

    private void HandleReporterNotify()
    {
        if (Reporter.Progress != null)
        {
            _uploadStatus =
                $"File: {Reporter.Progress.CurrentFileName}\n" +
                $"Files Complete: {Reporter.Progress.FilesCompleted}/{Reporter.Progress.TotalFiles}";
        }

        if (Reporter.Logs.Count > 0)
        {
            string logLines = string.Join('\n', Reporter.Logs.Select(l => l.message.TrimEnd()));
            _uploadStatus = string.IsNullOrWhiteSpace(_uploadStatus) ? logLines : $"{_uploadStatus}\n{logLines}";
        }

        InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// When a file is confirmed, upload it to the server, then to the DB
    /// </summary>
    /// <returns></returns>
    private async Task HandleFileSelection()
    {
        _isUploading = true;
        _uploadStatus = "Uploading...";
        _validationPrompt = null;
        try
        {
            // The file content is read into a stream
            if (_selectedFile != null)
            {
                Directory.CreateDirectory(UploadsFolderPath); // Ensure directory exists

                string trustedFileName = $"cmms_mappings_{DateTime.Now:yyyy-MM-dd}";
                _filePath = Path.Combine(UploadsFolderPath, trustedFileName + Path.GetExtension(_selectedFile.Name));

                // Stream the file data from the element to the server
                using (FileStream stream = new(_filePath, FileMode.Create))
                {
                    await _selectedFile.OpenReadStream().CopyToAsync(stream);
                }

                Reporter.ClearLogs();
                Reporter.InitializeProgress(1);
                InputProvider.SetConfirmResult(true);
                InputProvider.SetInputResult(_filePath);

                UploadCsvToDb uploader = new(InputProvider, Reporter);
                UploadResult result = await uploader.ExecuteAsync(_filePath);
                await Task.Delay(100);
                if (!Reporter.Logs.Any(l => l.level == ReportLevel.ERROR)){
                    ToastService.Notify(new(ToastType.Success, $"\n'{_selectedFile.Name  ?? "CSV"}' successfully uploaded."));
                    _lastUpload = await UploadCsvToDb.GetLastUpdatedDate();
                }
                else
                {
                    ToastService.Notify(new (ToastType.Danger, $"Upload failed."));
                }
                await LoadData();
            }
        }
        catch (Exception ex)
        {
            _uploadStatus += $"\nUpload failed: {ex.Message}";
        }
        finally{
            if(!string.IsNullOrWhiteSpace(_filePath))
                File.Delete(_filePath); // Clean up the uploads folder upon successful save to DB (the file is stored for less than a second)
            _selectedFile = null;
            _isUploading = false;
        }
    }

    /// <summary>
    /// Signature and pattern in order to implement IDisposable.
    /// Note: GC stands for garbage collector, which internally calls Dispose(false). By calling Dispose(true) here, we effectively circumvent that with the manual disposal.
    /// </summary>
    public void Dispose()
    {
        this.Dispose(true);
        GC.SuppressFinalize(this);
    }

    /// <summary>
    /// When this component unloads, unsubscribe from the I/O provider events.
    /// </summary>
    /// <param name="disposing">Whether to actually dispose. This is a help for the garbage collector.</param>
    public void Dispose(bool disposing){
        if (disposing)
        {
            InputProvider.OnInputRequested -= this.HandleInputRequested;
            Reporter.OnNotify -= this.HandleReporterNotify;
        }
    }
}
