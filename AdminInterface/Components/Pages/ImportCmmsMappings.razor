@page "/import-cmms-mappings"
@inherits EntityManagerBase<CmmsLine, CmmsLine>
@attribute [Authorize(Roles = "Manager")]

<PageTitle>Import CMMS Mappings</PageTitle>

<h2>Update CMMS Mappings</h2>

<p>Upload a CSV of the Maximo export here to update the line names (locations) associated with each machine's CMMS number when a machine moves between lines</p>
<p>Date of last upload: <strong>@lastUpload</strong></p>
<Alert Color="AlertColor.Warning" Class="d-inline-block"><Icon Name="IconName.ExclamationDiamond" />
    If successful, this will overwrite the existing CMMS mappings (associates will retain their <em>lines</em>, all machines will lose their connection to their old line).
</Alert>

<div class="centered-container mb-3">
    <div class="upload-card @(isDragging ? "drag-active" : "")">
        <label for="fileInput" class="upload-button">
            <i class="bi bi-cloud-arrow-up" style="font-size: 26px"></i> Choose CSV File
        </label>
        <InputFile id="fileInput" OnChange="HandleFileChanged" accept=".csv" class="hidden-input-overlay"
            @ondragenter="HandleDragEnter"
            @ondragleave="HandleDragLeave"
            @ondragover="HandleDragOver"
            @ondrop="HandleDrop" />
    </div>
</div>

@* Shown when the selected file fails validation *@
<div class="expandable-container">
    <div class="expandable-wrapper @(validationError != null ? "is-expanded" : "")">
        <div class="expandable-content">
            <Alert Color="AlertColor.Danger" Class="mt-3 animate-fade-in d-flex align-items-start justify-content-between">
                <div>
                    <strong><Icon Name="IconName.ExclamationTriangle" /> Invalid file:</strong>
                    @validationError
                </div>
                <button class="btn btn-link" @onclick="() => validationError = null">
                    <Icon Name="IconName.X"/>
                </button>
            </Alert>
        </div>
    </div>
</div>

@* Shown only when the file passes validation *@
<div class="expandable-container">
    <div class="expandable-wrapper @(ConfirmationOpen ? "is-expanded" : "")">
        <div class="expandable-content">
            <Alert Color="AlertColor.Danger" Class="mt-3 animate-fade-in">
                <p>
                    <strong>File Selected:</strong>
                    @(selectedFile?.Name ?? "No file selected")
                    (@((selectedFile?.Size ?? 0) / 1024) KB)
                </p>
                <Button Color="ButtonColor.Danger" @onclick="HandleFileConfirmation">
                    <Icon Name="IconName.ExclamationTriangle" /> Confirm Overwrite
                </Button>
                <Button Color="ButtonColor.Secondary" @onclick="CancelSelection">Cancel</Button>
            </Alert>
        </div>
    </div>
</div>


@if (IsLoading){
    <Spinner Color="SpinnerColor.Primary" />
} else {
    @if (TotalCount > 100){
        <Alert Color="AlertColor.Info" Class="d-inline-flex"><Icon Name="IconName.InfoCircle" Class="me-2" />This is a preview of the current mappings. There are more viewable on the View Line Status page.</Alert>
    }
    <UniversalTable T="CmmsLine" Items="DataView" />
}
