@using AdminInterface
@inherits EntityManagerBase<AssociateLine, AssocNameLine>
@inject ToastService toastService

<PageTitle>Manage Lines</PageTitle>

@if (targetAssociate != null){ @* For prerendering cases*@
    <div class="d-flex justify-content-between mb-3">
        <h2>Manage Lines for <strong>@targetAssociate.Name</strong></h2>
        @if (OnClose.HasDelegate){
            <button type="button" class="btn-close" title="Close line management split screen" @onclick="OnClose"></button>
        }
    </div>

    <div class="expandable-container">
        <div class="expandable-wrapper @(IsFormVisible ? "is-expanded" : "")">
            <div class="expandable-content">
                <div class="form-card mb-3">
                    <EditForm Model="@NewItem" OnValidSubmit="@HandleValidSubmit" class="form-card">
                        <DataAnnotationsValidator />

                        <div class="form-container">
                            <h5 class="form-title">
                                @(isEditing ? $"Edit Authorization: {NewItem.Line}" : $"Authorize New Line for {targetAssociate.Name}")
                            </h5>

                            <div class="row">
                                <div class="col-8">
                                    <label for="lineName" class="form-label">Line Name:</label>
                                    <InputText id="lineName"
                                            @bind-Value="NewItem.Line"
                                            class="form-control"
                                            list="lineOptions"
                                            disabled="@isEditing"
                                            autocomplete="off" />

                                    <datalist id="lineOptions">
                                        @foreach (var line in allAvailableLines)
                                        {
                                            <option value="@line" />
                                        }
                                    </datalist>
                                    <ValidationMessage For="@(() => NewItem.Line)" />
                                </div>

                                <div class="col-4">
                                    <label for="authLevel" class="form-label">Authorization Level:</label>
                                    <input id="authLevel" class="form-control" type="number" min="0" max="255"
                                                @bind="NewItem.AuthLevel" />

                                </div>
                            </div>

                            <div class="form-actions d-flex justify-content-center gap-4">
                                <button type="button" class="btn btn-outline-secondary btn-lg me-2" @onclick="CloseForm">Cancel</button>
                                <button type="submit" class="btn btn-primary">
                                    <i class="bi @(isEditing ? "bi-floppy" : "bi-plus-lg")"></i>
                                    @(isEditing ? "Update Authorization" : "Authorize Line")
                                </button>
                            </div>
                        </div>
                    </EditForm>
                    <ErrorDisplay ErrorMessage="@ErrorMessage" />
                </div>
            </div>
        </div>
        <div class="expandable-wrapper @(!IsFormVisible ? "is-expanded" : "")">
            <div class="expandable-content">
                <div class="row">
                    <div class="col-6">
                        <EditForm Model="this" OnValidSubmit="() => LoadData()">
                            <div class="input-group mb-2">
                                <InputText
                                    id="searchBar"
                                    @bind-Value="searchText"
                                    @onblur="HandleBlur"
                                    class="form-control"
                                    placeholder="Search by line name"
                                    autocomplete="off" />
                                    @if (!string.IsNullOrEmpty(searchText))
                                    {
                                        <span class="input-group-text clear-addon">
                                            <button type="button" class="btn-close" aria-label="Clear"
                                                @onclick="ClearSearchBar"
                                                style="font-size: 0.8rem;"></button>
                                        </span>
                                    }
                                <button type="submit" class="btn btn-primary px-4 d-flex align-items-center">
                                <i class="bi bi-arrow-right" style="font-size: 1.5rem;"></i></button>
                            </div>
                        </EditForm>
                    </div>
                </div>

                <div class="d-flex justify-content-center mb-3">
                    <button class="btn btn-success" @onclick="ShowForm">
                        <i class="bi bi-plus-lg"></i> Add New Line for @targetAssociate.Name
                    </button>
                </div>
            </div>
        </div>
    </div>

    @if (IsLoading){
        <Spinner Color="SpinnerColor.Secondary" />
    } else {
        @if (TotalCount > 0) {
            <TablePresenter
            TWrite="AssociateLine"
            TRead="AssocNameLine"
            Base="this"
            Target="targetPermission"
            OnExpand="HandleExpand"
            OnDelete="HandleDelete" />
        } else {
            @if (string.IsNullOrEmpty(searchText)){
                <div class="text-center">
                    <h3>No lines authorized for @targetAssociate.Name</h3>
                </div>
            } else {
                <div class="text-center">
                    <h3>No lines authorized for @targetAssociate.Name matching "@searchText"</h3>
                </div>
            }

        }
    }

    <DeleteDialog @ref="DeleteDialog" />
}
