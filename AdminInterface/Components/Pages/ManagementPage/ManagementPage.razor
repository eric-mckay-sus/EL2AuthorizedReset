@page "/manage"
@attribute [Authorize(Roles = "Admin")]

<PageTitle>Manage</PageTitle>

<div class="row overflow-hidden flex-nowrap">
    @* Split screen when expanded, otherwise fullscreen the associate table *@
    <div class="@(isTargeting ? "col-7" : "col-12") transition-width">
        <ManageAssociates target="target" HandleExpand="HandleExpand" OnItemChanged="HandleAssociateNotShown"/>
    </div>
    <div class="@(isTargeting ? "col-5" : "col-0") transition-width overflow-hidden" 
         style="@(isTargeting ? "" : "display:none;")">
            @if (isTargeting) {
                <ManageLines targetAssociate="target" OnClose="HandleClose" />
            }
    </div>
</div>

@code{
    Associate? target;
    bool isTargeting = false;
    public void HandleExpand(Associate associate) {
        if (associate.Equals(target)){
            HandleClose();
        } else {
            target = associate;
            isTargeting = true;
        }
    }
    public void HandleClose(){
        target = null;
        isTargeting = false;
    }

    private void HandleAssociateNotShown(Associate changedAssociate)
    {
        if (target != null && changedAssociate.Equals(target))
        {
            HandleClose();
        }
    }
}