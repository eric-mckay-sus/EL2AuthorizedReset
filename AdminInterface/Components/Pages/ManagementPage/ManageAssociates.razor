@using AdminInterface
@inherits EntityManagerBase<Associate, Associate>

<PageTitle>Manage Associates</PageTitle>

<h2>Add/Remove an Associate</h2>

<div class="expandable-container">
    <div class="expandable-wrapper @(IsFormVisible ? "is-expanded" : "")">
        <div class="expandable-content">
            <div class="form-card mb-3">
                <EditForm Model="@NewItem" OnValidSubmit="@HandleValidSubmit">
                    <DataAnnotationsValidator />
                    <div class="form-container">
                        <h5 class="form-title">Associate Details</h5>
                        <div class="row g-3">
                            <div class="col-6">
                                <label for="name" class="form-label">Associate Name:</label>
                                <InputText id="name" @bind-Value="NewItem.Name" class="form-control" autocomplete="off" />
                                <ValidationMessage For="@(() => NewItem.Name)" />
                            </div>
                            <div class="col-3">
                                <label for="assocNum" class="form-label">Associate Number:</label>
                                <InputNumber id="assocNum" @bind-Value="NewItem.AssociateNum" class="form-control" />
                                <ValidationMessage For="@(() => NewItem.AssociateNum)" />
                            </div>
                            <div class="col-3">
                                <label for="badgeNum" class="form-label">Badge Number:</label>
                                <InputNumber id="badgeNum" @bind-Value="NewItem.BadgeNum" class="form-control" />
                                <ValidationMessage For="@(() => NewItem.BadgeNum)" />
                            </div>
                        </div>

                        <div class="form-actions d-flex justify-content-center gap-4">
                            <button type="button" class="btn btn-outline-secondary btn-lg me-2" @onclick="CloseForm">Cancel</button>
                            <button type="submit" class="btn btn-primary btn-lg px-4">
                                <i class="bi bi-plus-lg"></i> Save Associate
                            </button>
                        </div>
                    </div>
                </EditForm>
                <ErrorDisplay ErrorMessage="@ErrorMessage" />
            </div>
        </div>
    </div>

    <div class="expandable-wrapper @(!IsFormVisible ? "is-expanded" : "")">
        <div class="expandable-content">
             @if (Target == null && HandleExpand.HasDelegate){
                <h6 class="mb-2">Click the three lines next to an associate to see their authorized lines</h6>
            }
            <div class="row">
                <div class="col-6">
                    <EditForm Model="this" OnValidSubmit="() => LoadData()">
                        <div class="input-group mb-2">
                            <InputText id="searchBar" @bind-Value="searchText" @onblur="HandleBlur" class="form-control" placeholder="Search by associate name or associate/badge number" autocomplete="off" />
                            @if (!string.IsNullOrEmpty(searchText)) {
                                <span class="input-group-text clear-addon">
                                    <button type="button" class="btn-close" aria-label="Clear" @onclick="ClearSearchBar" style="font-size: 0.8rem;"></button>
                                </span>
                            }
                            <button type="submit" class="btn btn-primary px-4 d-flex align-items-center">
                                <i class="bi bi-arrow-right" style="font-size: 1.5rem;"></i>
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>

            <div class="d-flex justify-content-center mb-3">
                <button class="btn btn-success" @onclick="ShowForm">
                    <i class="bi bi-plus-lg"></i> Add New Associate
                </button>
            </div>
        </div>
    </div>
</div>

@if (IsLoading){
    <Spinner Color="SpinnerColor.Primary" />
} else {
    @if (DataView.Count > 0) {
        <TablePresenter
            TWrite="Associate"
            TRead="Associate"
            Base="this"
            Target="Target"
            OnDelete="HandleDelete"
            OnExpand="HandleExpand" />
    } else {
        <h3>No associates @(SearchingInt ? $"with associate/badge number \"{searchText}\"" : $"with name containing \"{searchText}\"")</h3>
    }
}

<DeleteDialog @ref="DeleteDialog" />
